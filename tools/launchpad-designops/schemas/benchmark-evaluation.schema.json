{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchpad-designops.local/schemas/benchmark-evaluation.schema.json",
  "title": "LaunchPad independent benchmark evaluation",
  "type": "object",
  "required": ["caseId", "runId", "evaluator", "scores", "findings", "evidence", "unsupportedClaims", "confidence"],
  "properties": {
    "caseId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "evaluator": { "type": "string", "minLength": 1 },
    "scores": {
      "type": "object",
      "required": ["requirements", "taskClarity", "accessibility", "truthfulness", "subjectSpecificity", "distinctiveness", "visualCraft", "responsiveBehavior", "implementationFeasibility"],
      "properties": {
        "requirements": { "$ref": "#/$defs/score" },
        "taskClarity": { "$ref": "#/$defs/score" },
        "accessibility": { "$ref": "#/$defs/score" },
        "truthfulness": { "$ref": "#/$defs/score" },
        "subjectSpecificity": { "$ref": "#/$defs/score" },
        "distinctiveness": { "$ref": "#/$defs/score" },
        "visualCraft": { "$ref": "#/$defs/score" },
        "responsiveBehavior": { "$ref": "#/$defs/score" },
        "implementationFeasibility": { "$ref": "#/$defs/score" }
      },
      "additionalProperties": false
    },
    "findings": { "type": "array", "items": { "type": "object", "required": ["severity", "message", "evidence"], "properties": { "severity": { "type": "string", "enum": ["P0", "P1", "P2"] }, "message": { "type": "string" }, "evidence": { "type": "string" } }, "additionalProperties": false } },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "unsupportedClaims": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
  },
  "$defs": { "score": { "type": "number", "minimum": 1, "maximum": 5 } },
  "additionalProperties": false
}
