{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchpad-designops.local/schemas/requirements-map.schema.json",
  "title": "LaunchPad evidence and requirements registry",
  "type": "object",
  "required": ["sources", "users", "tasks", "claims", "assumptions", "unknowns", "deliverables", "directionCriteria"],
  "properties": {
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
    "users": { "type": "array", "items": { "$ref": "#/$defs/evidenceRecord" } },
    "tasks": { "type": "array", "items": { "$ref": "#/$defs/evidenceRecord" } },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "assumptions": { "type": "array", "items": { "$ref": "#/$defs/assumption" } },
    "unknowns": { "type": "array", "items": { "$ref": "#/$defs/unknown" } },
    "deliverables": { "type": "array", "items": { "$ref": "#/$defs/deliverable" } },
    "directionCriteria": { "type": "array", "items": { "$ref": "#/$defs/criterion" } },
    "auditOnlyException": { "type": "string", "minLength": 20 }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
    "refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
    "ref": { "type": "string", "pattern": "^(source|user|task|claim|assumption|unknown|deliverable|criterion):[A-Za-z][A-Za-z0-9_-]*$" },
    "source": {
      "type": "object",
      "required": ["id", "title", "type", "locator", "status", "confidence", "criticality"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "type": { "enum": ["document", "stakeholder", "research", "standard", "repository", "assumption"] },
        "locator": { "type": "string", "minLength": 1 },
        "status": { "enum": ["verified", "stakeholder-provided", "bounded-assumption"] },
        "confidence": { "enum": ["low", "medium", "high"] },
        "criticality": { "enum": ["low", "medium", "high", "critical"] },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "evidenceRecord": {
      "type": "object",
      "required": ["id", "description", "evidenceRefs", "priority"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "type": "string", "minLength": 1 },
        "evidenceRefs": { "$ref": "#/$defs/refs" },
        "priority": { "enum": ["primary", "secondary"] }
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": ["id", "text", "status", "sourceRefs", "approvedUsage"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "minLength": 1 },
        "status": { "enum": ["verified", "stakeholder", "assumption", "unsupported"] },
        "sourceRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
        "approvedUsage": { "type": "array", "uniqueItems": true, "items": { "enum": ["proposalSpec", "demoSpec"] } }
      },
      "additionalProperties": false
    },
    "assumption": {
      "type": "object",
      "required": ["id", "description", "sourceRefs", "confidence", "risk", "affectedDecisions", "validation"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "type": "string", "minLength": 1 },
        "sourceRefs": { "$ref": "#/$defs/refs" },
        "confidence": { "enum": ["low", "medium", "high"] },
        "risk": { "enum": ["low", "medium", "high", "critical"] },
        "affectedDecisions": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["primary-task", "safety", "trust", "content-structure", "interaction-model", "visual-expression", "implementation", "representative-content"] }
        },
        "validation": {
          "type": "object",
          "required": ["requiredAt", "hypothesis", "killCriteria"],
          "properties": {
            "requiredAt": { "enum": ["none", "direction", "handoff", "release"] },
            "hypothesis": { "type": "string", "minLength": 20 },
            "killCriteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 20 } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "unknown": {
      "type": "object",
      "required": ["id", "description", "risk", "blocking"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "type": "string", "minLength": 1 },
        "risk": { "enum": ["low", "medium", "high", "critical"] },
        "blocking": { "type": "boolean" },
        "rationale": { "type": "string", "minLength": 20 }
      },
      "additionalProperties": false
    },
    "deliverable": {
      "type": "object",
      "required": ["id", "artifact", "claimRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "artifact": { "enum": ["proposalSpec", "demoSpec"] },
        "claimRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "criterion": {
      "type": "object",
      "required": ["id", "description", "kind", "evidenceRefs", "measurement"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "type": "string", "minLength": 20 },
        "kind": { "enum": ["hard", "comparative"] },
        "evidenceRefs": { "$ref": "#/$defs/refs" },
        "measurement": { "type": "string", "minLength": 20 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
