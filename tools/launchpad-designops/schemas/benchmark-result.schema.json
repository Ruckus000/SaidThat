{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchpad-designops.local/schemas/benchmark-result.schema.json",
  "title": "LaunchPad benchmark run result",
  "type": "object",
  "required": ["caseId", "runId", "status", "artifacts", "hardBlockers", "evidence"],
  "properties": {
    "caseId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["pass", "review-required", "blocked", "error"] },
    "artifacts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "hardBlockers": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": false
}
