{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchpad-designops.local/schemas/content-state-map.schema.json",
  "title": "Content state map",
  "type": "object",
  "required": ["states", "verificationConditions"],
  "properties": {
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "applicability"],
        "properties": {
          "name": { "enum": ["normal", "loading", "empty", "error", "success", "permission-unavailable"] },
          "applicability": { "enum": ["applicable", "not-applicable"] },
          "content": { "type": "string", "minLength": 1 },
          "implementationRef": { "type": "string", "minLength": 1 },
          "recovery": { "type": "string", "minLength": 1 },
          "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "notApplicableReason": { "type": "string", "minLength": 20 }
        },
        "allOf": [
          {
            "if": { "properties": { "applicability": { "const": "applicable" } } },
            "then": { "required": ["content", "implementationRef", "recovery", "evidenceRefs"], "not": { "required": ["notApplicableReason"] } },
            "else": { "required": ["notApplicableReason", "evidenceRefs"], "not": { "required": ["content"] } }
          },
          {
            "if": { "properties": { "name": { "const": "normal" } } },
            "then": { "properties": { "applicability": { "const": "applicable" } } }
          }
        ],
        "additionalProperties": false
      }
    },
    "verificationConditions": {
      "type": "object",
      "required": ["mobile", "long-content"],
      "properties": {
        "mobile": { "$ref": "#/$defs/condition" },
        "long-content": { "$ref": "#/$defs/condition" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "condition": {
      "type": "object",
      "required": ["implementationRef", "evidenceRefs"],
      "properties": {
        "implementationRef": { "type": "string", "minLength": 1 },
        "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
