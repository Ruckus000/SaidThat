{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchpad-designops.local/schemas/tokens.schema.json",
  "title": "DTCG-compatible design tokens",
  "type": "object",
  "description": "A deliberately small contract over the DTCG token format. Token groups may contain nested groups and tokens.",
  "additionalProperties": { "$ref": "#/$defs/groupOrToken" },
  "$defs": {
    "groupOrToken": {
      "oneOf": [
        {
          "type": "object",
          "required": ["$value"],
          "properties": {
            "$value": {},
            "$type": { "type": "string" },
            "$description": { "type": "string" },
            "$extensions": { "type": "object" }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "$type": { "type": "string" },
            "$description": { "type": "string" },
            "$extensions": { "type": "object" }
          },
          "additionalProperties": { "$ref": "#/$defs/groupOrToken" }
        }
      ]
    }
  }
}
