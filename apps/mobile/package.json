{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.7",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-sensors": "~57.0.2",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "^15.15.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "jest": "^29.7.0",
    "jest-expo": "57.0.2",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:ios": "expo export --platform ios --output-dir /tmp/said-that-ios-export",
    "export:android": "expo export --platform android --output-dir /tmp/said-that-android-export",
    "test": "npm run test:unit && npm run test:app",
    "test:unit": "node --experimental-default-type=module --test src/**/*.test.mjs",
    "test:app": "jest"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/*.test.tsx"
    ]
  },
  "private": true
}
