{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.7",
    "expo-sensors": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:ios": "expo export --platform ios --output-dir /tmp/said-that-ios-export",
    "export:android": "expo export --platform android --output-dir /tmp/said-that-android-export",
    "test": "node --experimental-default-type=module --test src/domain/game.test.mjs src/components/uiState.test.mjs src/sensors/roomBeaconMotion.test.mjs src/settings/settingsPolicy.test.mjs src/content/validateDeck.test.mjs src/release/releasePrep.test.mjs"
  },
  "private": true
}
