{
  "color": {
    "$type": "color",
    "canvas": { "$value": "#111318", "$description": "Low-glare shared-stage background." },
    "surface": { "$value": "#1A1F29", "$description": "Elevated readable surface." },
    "text": { "primary": { "$value": "#F7F8FA", "$description": "Primary text on canvas and surface." }, "muted": { "$value": "#B7C0CC", "$description": "Supporting text with text-plus-shape status cues." } },
    "signal": { "$value": "#C8FF3D", "$description": "Primary game action and current-context signal; never truth alone." },
    "action": { "primary": { "$value": "{color.signal}", "$description": "Primary tap action." }, "secondary": { "$value": "#334155", "$description": "Secondary non-destructive tap action." } },
    "status": { "safe": { "$value": "#65D6A6", "$description": "Supporting success detail; always paired with text." }, "warning": { "$value": "#F5C451", "$description": "Supporting withheld or queued-state detail; always paired with text." }, "danger": { "$value": "#FF7A90", "$description": "Supporting error detail; always paired with text." } }
  },
  "typography": {
    "family": { "$type": "fontFamily", "system": { "$value": ["System"], "$description": "Platform system family for native dynamic-type compatibility." } },
    "weight": { "$type": "fontWeight", "regular": { "$value": 400, "$description": "Body copy." }, "semibold": { "$value": 600, "$description": "Actions and attribution." }, "bold": { "$value": 700, "$description": "Shared statement hierarchy." } },
    "size": { "$type": "dimension", "body": { "$value": { "value": 18, "unit": "px" }, "$description": "Readable body copy; native setting may enlarge it." }, "statement": { "$value": { "value": 32, "unit": "px" }, "$description": "Shared prompt baseline; content must wrap without losing controls." }, "beacon": { "$value": { "value": 12, "unit": "px" }, "$description": "Compact persistent game context." } }
  },
  "spacing": { "$type": "dimension", "xs": { "$value": { "value": 8, "unit": "px" }, "$description": "Tight internal separation." }, "sm": { "$value": { "value": 16, "unit": "px" }, "$description": "Control grouping." }, "md": { "$value": { "value": 24, "unit": "px" }, "$description": "Section separation." }, "lg": { "$value": { "value": 40, "unit": "px" }, "$description": "Stage separation." } },
  "radius": { "$type": "dimension", "control": { "$value": { "value": 18, "unit": "px" }, "$description": "Rounded primary touch surface." }, "panel": { "$value": { "value": 24, "unit": "px" }, "$description": "Calm room-stage panel." } },
  "target": { "$type": "dimension", "minimum": { "$value": { "value": 56, "unit": "px" }, "$description": "MVP touch-control minimum; verify natively before release." } },
  "motion": { "$type": "duration", "none": { "$value": { "value": 0, "unit": "ms" }, "$description": "Reduced-motion baseline." }, "transition": { "$value": { "value": 160, "unit": "ms" }, "$description": "Optional orientation-only transition; not truth or commit feedback." } },
  "accessibility": { "$type": "string", "contrast": { "$value": "WCAG 2.2 AA contrast target; check rendered native combinations before release.", "$description": "Contractual target, not a conformance claim." }, "truth": { "$value": "Every truth or status state uses words plus a non-color cue.", "$description": "No color-only meaning." }, "reducedMotion": { "$value": "Tap-only, no-motion completion is equivalent to the primary round.", "$description": "No timing or motion dependency." } },
  "hotmic": {
    "$description": "HOT MIC direction (docs/ux-design-direction.md). Additive; mirrors apps/mobile/src/theme/palette.js + hotmic tokens. Dark-primary; light is a warm-paper scheme. AA enforced by apps/mobile/src/theme/contrast.test.mjs. Not yet consumed by components (Phase 2).",
    "color": {
      "$type": "color",
      "dark": { "canvas": "#170F14", "surface": "#211722", "surfaceRaised": "#2E2130", "outline": "#40304A", "textPrimary": "#F6ECF3", "textMuted": "#BBA6C4", "marigold": "#FFB020", "marigoldFill": "#FFB020", "onHero": "#1A0E0A", "payoffRose": "#FF4D8D", "statusTeal": "#7FD1C4", "statusOchre": "#F2A65A", "safe": "#65D6A6", "warning": "#F5C451", "danger": "#FF7A90", "focusHalo": "#FFE08A", "focusCore": "#1A0E0A" },
      "light": { "canvas": "#FBF3EC", "surface": "#F1E4DA", "surfaceRaised": "#EAD9CB", "outline": "#D8C6B8", "textPrimary": "#241017", "textMuted": "#5C4A55", "marigold": "#8F5200", "marigoldFill": "#FFB020", "onHero": "#1A0E0A", "payoffRose": "#C6386E", "statusTeal": "#1B655A", "statusOchre": "#8A5012", "focusHalo": "#8F5200", "focusCore": "#1A0E0A" },
      "$rule": "marigold marks current-action/current-context only (at most one lit element per screen); multi-selection is neutral plum; payoffRose is color-symmetric across hit/miss; truth treatments (teal/ochre) never appear without a plain word + non-color shape."
    },
    "type": { "$type": "dimension", "displayXL": { "size": 56, "lineHeight": 60, "weight": 800, "tracking": -0.5 }, "displayL": { "size": 40, "lineHeight": 44, "weight": 800, "tracking": -0.25 }, "statement": { "size": 46, "minSize": 28, "lineHeight": 50, "weight": 600, "tracking": 0 }, "verdict": { "size": 40, "lineHeight": 44, "weight": 800, "tracking": 0.5 }, "title": { "size": 24, "lineHeight": 30, "weight": 700 }, "body": { "size": 18, "lineHeight": 24, "weight": 400 }, "label": { "size": 15, "lineHeight": 20, "weight": 800, "tracking": 1.2 }, "caption": { "size": 13, "lineHeight": 18, "weight": 600, "tracking": 0.4 } },
    "spacing": { "$type": "dimension", "xxs": 4, "xs": 8, "sm": 12, "md": 16, "lg": 24, "xl": 32, "xxl": 40, "xxxl": 64 },
    "radius": { "$type": "dimension", "sm": 10, "control": 18, "panel": 24, "pill": 999 },
    "target": { "$type": "dimension", "minimum": 56, "hitSlop": 8 },
    "spring": { "$description": "Core RN Animated presets (no Reanimated). kick is a dip->overshoot->settle sequence fired only on the game answer-commit.", "snappy": { "stiffness": 260, "damping": 18, "mass": 1 }, "standard": { "stiffness": 170, "damping": 22, "mass": 1 }, "weighty": { "stiffness": 120, "damping": 26, "mass": 1.1 }, "kick": { "dip": 0.94, "overshoot": 1.03, "settle": 1, "stiffness": 300, "damping": 16, "mass": 1 } },
    "motion": { "$type": "duration", "instant": { "$value": { "value": 0, "unit": "ms" } }, "quick": { "$value": { "value": 120, "unit": "ms" } }, "travel": { "$value": { "value": 240, "unit": "ms" } }, "easing": "cubic-bezier(0.2,0.7,0.3,1)" }
  }
}
