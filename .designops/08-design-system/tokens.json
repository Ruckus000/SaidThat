{
  "color": {
    "$type": "color",
    "canvas": { "$value": "#0B0E13", "$description": "Low-glare shared-stage background (VOLT)." },
    "surface": { "$value": "#11161F", "$description": "Elevated readable surface." },
    "text": { "primary": { "$value": "#F2F5F9", "$description": "Primary text on canvas and surface." }, "muted": { "$value": "#9BA6B5", "$description": "Supporting text with text-plus-shape status cues." } },
    "signal": { "$value": "#CDF244", "$description": "Primary game action and current-context signal; never truth alone." },
    "accent": { "$value": "#FF4FA0", "$description": "Secondary accent for choice labels, miss flash, and destructive actions; always paired with text." },
    "action": { "primary": { "$value": "{color.signal}", "$description": "Primary tap action." }, "secondary": { "$value": "#2E3A4A", "$description": "Secondary non-destructive tap action outline." } },
    "status": { "safe": { "$value": "#65D6A6", "$description": "Supporting success detail; always paired with text." }, "warning": { "$value": "#F0A63C", "$description": "Supporting withheld or queued-state detail; always paired with text." }, "danger": { "$value": "#FF7A90", "$description": "Supporting error detail; always paired with text." } }
  },
  "typography": {
    "family": { "$type": "fontFamily", "system": { "$value": ["System"], "$description": "Platform system family for native dynamic-type compatibility." } },
    "weight": { "$type": "fontWeight", "regular": { "$value": 400, "$description": "Body copy." }, "semibold": { "$value": 600, "$description": "Actions and attribution." }, "bold": { "$value": 700, "$description": "Shared statement hierarchy." } },
    "size": { "$type": "dimension", "body": { "$value": { "value": 18, "unit": "px" }, "$description": "Readable body copy; native setting may enlarge it." }, "statement": { "$value": { "value": 32, "unit": "px" }, "$description": "Shared prompt baseline; content must wrap without losing controls." }, "beacon": { "$value": { "value": 12, "unit": "px" }, "$description": "Compact persistent game context." } }
  },
  "spacing": { "$type": "dimension", "xs": { "$value": { "value": 8, "unit": "px" }, "$description": "Tight internal separation." }, "sm": { "$value": { "value": 16, "unit": "px" }, "$description": "Control grouping." }, "md": { "$value": { "value": 24, "unit": "px" }, "$description": "Section separation." }, "lg": { "$value": { "value": 40, "unit": "px" }, "$description": "Stage separation." } },
  "radius": { "$type": "dimension", "control": { "$value": { "value": 18, "unit": "px" }, "$description": "Rounded primary touch surface." }, "panel": { "$value": { "value": 24, "unit": "px" }, "$description": "Calm room-stage panel." } },
  "target": { "$type": "dimension", "minimum": { "$value": { "value": 56, "unit": "px" }, "$description": "MVP touch-control minimum; verify natively before release." } },
  "motion": { "$type": "duration", "none": { "$value": { "value": 0, "unit": "ms" }, "$description": "Reduced-motion baseline." }, "transition": { "$value": { "value": 160, "unit": "ms" }, "$description": "Optional orientation-only transition; not truth or commit feedback." } },
  "accessibility": { "$type": "string", "contrast": { "$value": "WCAG 2.2 AA contrast target; check rendered native combinations before release.", "$description": "Contractual target, not a conformance claim." }, "truth": { "$value": "Every truth or status state uses words plus a non-color cue.", "$description": "No color-only meaning." }, "reducedMotion": { "$value": "Tap-only, no-motion completion is equivalent to the primary round.", "$description": "No timing or motion dependency." } },
  "hotmic": {
    "$description": "VOLT direction (Headsup-style UX redesign explorations / Volt Prototype). Additive; mirrors apps/mobile/src/theme/palette.js + hotmic tokens. Dark-primary cool stage with lime signal and pink accent. AA enforced by apps/mobile/src/theme/contrast.test.mjs. marigold/payoffRose keys alias lime/pink for stable call sites.",
    "color": {
      "$type": "color",
      "dark": { "canvas": "#0B0E13", "surface": "#11161F", "surfaceRaised": "#161C27", "outline": "#2E3A4A", "textPrimary": "#F2F5F9", "textMuted": "#9BA6B5", "textDim": "#5E6A7A", "lime": "#CDF244", "limeFill": "#CDF244", "pink": "#FF4FA0", "pinkFill": "#FF4FA0", "marigold": "#CDF244", "marigoldFill": "#CDF244", "onHero": "#0B0E13", "payoffRose": "#FF4FA0", "statusTeal": "#7FD1C4", "statusOchre": "#F0A63C", "safe": "#65D6A6", "warning": "#F0A63C", "danger": "#FF7A90", "focusHalo": "#CDF244", "focusCore": "#0B0E13" },
      "light": { "canvas": "#F2F5F9", "surface": "#E8EDF4", "surfaceRaised": "#DCE3EE", "outline": "#C5CEDA", "textPrimary": "#0B0E13", "textMuted": "#4A5564", "textDim": "#5E6A7A", "lime": "#3A5A00", "limeFill": "#CDF244", "pink": "#A0185A", "pinkFill": "#FF4FA0", "marigold": "#3A5A00", "marigoldFill": "#CDF244", "onHero": "#0B0E13", "payoffRose": "#A0185A", "statusTeal": "#1B655A", "statusOchre": "#8A5012", "focusHalo": "#3A5A00", "focusCore": "#0B0E13" },
      "$rule": "lime marks current-action/current-context and primary CTAs; pink is the secondary answer fill, miss flash, and destructive accent; every colored state keeps a text label (and MARK glyph for truth); truth treatments never appear without a plain word + non-color shape."
    },
    "type": { "$type": "dimension", "displayXL": { "size": 92, "lineHeight": 84, "weight": 800, "tracking": -2 }, "displayL": { "size": 58, "lineHeight": 56, "weight": 800, "tracking": -2 }, "statement": { "size": 34, "minSize": 28, "lineHeight": 40, "weight": 700, "tracking": 0 }, "verdict": { "size": 96, "lineHeight": 88, "weight": 800, "tracking": -3 }, "title": { "size": 44, "lineHeight": 42, "weight": 800, "tracking": -1 }, "body": { "size": 17, "lineHeight": 24, "weight": 400 }, "label": { "size": 14, "lineHeight": 18, "weight": 800, "tracking": 2 }, "caption": { "size": 13, "lineHeight": 18, "weight": 600, "tracking": 0.4 } },
    "spacing": { "$type": "dimension", "xxs": 4, "xs": 8, "sm": 12, "md": 16, "lg": 24, "xl": 32, "xxl": 40, "xxxl": 64 },
    "radius": { "$type": "dimension", "sm": 10, "control": 16, "panel": 28, "pill": 999 },
    "target": { "$type": "dimension", "minimum": 56, "hitSlop": 8 },
    "spring": { "$description": "Core RN Animated presets (no Reanimated). kick is a dip->overshoot->settle sequence fired only on the game answer-commit.", "snappy": { "stiffness": 260, "damping": 18, "mass": 1 }, "standard": { "stiffness": 170, "damping": 22, "mass": 1 }, "weighty": { "stiffness": 120, "damping": 26, "mass": 1.1 }, "kick": { "dip": 0.97, "overshoot": 1.03, "settle": 1, "stiffness": 300, "damping": 16, "mass": 1 } },
    "motion": { "$type": "duration", "instant": { "$value": { "value": 0, "unit": "ms" } }, "quick": { "$value": { "value": 120, "unit": "ms" } }, "travel": { "$value": { "value": 240, "unit": "ms" } }, "stamp": { "$value": { "value": 450, "unit": "ms" } }, "locking": { "$value": { "value": 850, "unit": "ms" } }, "easing": "cubic-bezier(0.2,0.7,0.3,1)" }
  }
}
