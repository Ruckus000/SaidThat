#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

zero=0000000000000000000000000000000000000000
empty_tree=4b825dc642cb6eb9a060e54bf8d69288fbee4904
saw_ref=0

while read -r local_ref local_sha remote_ref remote_sha; do
  saw_ref=1
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi
  if [ "$remote_sha" = "$zero" ]; then
    # A new feature branch inherits main's history. Compare only its unique
    # commits so prior, intentionally blocked implementation history does not
    # recategorize a planning-only branch. The first push to main still checks
    # its complete history against the empty tree.
    if [ "$remote_ref" != "refs/heads/main" ] && git rev-parse --verify --quiet origin/main >/dev/null; then
      base_sha=$(git merge-base origin/main "$local_sha")
      range="$base_sha..$local_sha"
    else
      range="$empty_tree..$local_sha"
    fi
  else
    range="$remote_sha..$local_sha"
  fi
  node tools/designops/enforce.mjs --range "$range"
done

if [ "$saw_ref" -eq 0 ]; then
  # Some host runners invoke the hook without pre-push ref lines. For this
  # repository's feature branches, classify commits since the tracked main
  # branch instead of treating a clean working tree as implementation work.
  if git rev-parse --verify --quiet origin/main >/dev/null; then
    base_sha=$(git merge-base origin/main HEAD)
    node tools/designops/enforce.mjs --range "$base_sha..HEAD"
  else
    # No safe comparison range is available, so retain fail-closed behavior.
    node tools/designops/enforce.mjs --working-tree
  fi
fi
